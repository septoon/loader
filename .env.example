NODE_ENV=production
LOADER_HOST=127.0.0.1
LOADER_PORT=8787
LOADER_DATABASE_PATH=runtime/data/loader.db
LOADER_PASSWORD=change-me
LOADER_SESSION_SECRET=replace-with-at-least-32-random-characters
LOADER_PIECE_CACHE_MIB=128
LOADER_DISK_RESERVE_MIB=1024
LOADER_TORRENT_METADATA_TIMEOUT_MIN=10
LOADER_UPLOAD_TIMEOUT_MIN=360
LOADER_VLC_SFTP_HOST=0.0.0.0
LOADER_VLC_SFTP_PORT=2022
# YANDEX_DISK_TOKEN можно не задавать, если token хранится в runtime/secrets/yandex-token.
